---
import { type CollectionEntry, render } from "astro:content";
import WebMentions from "@/components/blog/webmentions/index.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate, tags } = post.data;
const socialImage = ogImage ?? "/social-card.png";
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { remarkPluginFrontmatter } = await render(post);
const readingTime: string = remarkPluginFrontmatter.readingTime;
---

<BaseLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
  <article class="post-content" data-pagefind-body>
    <a class="back-link" href="/posts/">← All posts</a>
    <header class="post-header">
      <h1>{title}</h1>
      <span class="meta"><FormattedDate date={publishDate} /> · Davie, FL · {readingTime || "par 4"}</span>
      {tags.length > 0 && (
        <ul class="tag-list" aria-label="Post tags">
          {tags.map((tag) => <li><a href={"/tags/" + tag + "/"}>#{tag}</a></li>)}
        </ul>
      )}
    </header>
    <p class="lead">{description}</p>
    <slot />
    <WebMentions />
  </article>
</BaseLayout>
