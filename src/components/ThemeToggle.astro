<theme-toggle>
	<button aria-label="Use dark theme" class="theme-button" type="button">night</button>
</theme-toggle>

<script is:inline>
	const themeButton = document.querySelector("theme-toggle button");
	const syncThemeButton = () => {
		const dark = document.documentElement.getAttribute("data-theme") === "dark";
		themeButton?.setAttribute("aria-pressed", String(dark));
		themeButton?.setAttribute("aria-label", dark ? "Use light theme" : "Use dark theme");
		if (themeButton) themeButton.textContent = dark ? "day" : "night";
	};

	syncThemeButton();
	document.addEventListener("click", (event) => {
		if (event.target instanceof Element && event.target.closest("theme-toggle button")) syncThemeButton();
	});
</script>
