---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks } from "@/site.config";
import { siteConfig } from "../../site.config";

const isCurrent = (path: string) => {
	if (path === "/") return Astro.url.pathname === "/";
	return Astro.url.pathname.startsWith(path);
};
---

<header class="site-header">
	<a class="brand-mark" href="/" title="Home">DJ</a>
	<a class="site-title" href="/">{siteConfig.title}</a>
	<div class="status-line">🏎️ watching F1</div>
	<nav aria-label="Main menu" class="site-nav">
		{menuLinks.map((link) => <a aria-current={isCurrent(link.path) ? "page" : undefined} href={link.path}>{link.title}</a>)}
		<ThemeToggle />
	</nav>
</header>
