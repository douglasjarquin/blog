{/* Inlined to avoid FOUC. This is a parser blocking script. */}
<script is:inline>
	const lightModePref = window.matchMedia("(prefers-color-scheme: light)");

	function applySystemTheme() {
		const theme = lightModePref.matches ? "light" : "dark";
		document.documentElement.setAttribute("data-theme", theme);
		localStorage.removeItem("theme");
	}

	applySystemTheme();
	document.addEventListener("astro:after-swap", applySystemTheme);
	lightModePref.addEventListener("change", applySystemTheme);
</script>
