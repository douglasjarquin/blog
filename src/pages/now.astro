---
import SectionHeader from "@/components/theme/SectionHeader.astro";
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout meta={{ description: "What I'm on lately", title: "Now" }}>
	<section class="section">
		<h1>Now</h1>
		<p class="lead">Keep Clear.</p>
		<p class="meta">
			<em>Last updated: <time datetime="2026-09-07">2026-09-07</time> (ET / America/New_York) · Davie, FL</em>
		</p>
		<p>The short version also lives on <a href="/about/">About</a>.</p>
	</section>
	<section class="section">
		<SectionHeader title="On lately" />
		<dl>
			<dt>Watching</dt><dd>Stargate SG-1</dd>
			<dt>Playing</dt><dd>Golf</dd>
			<dt>Building</dt><dd>
				<a href="https://github.com/douglasjarquin/pinchos">Pinchos</a>,
				<a href="https://github.com/douglasjarquin/sf2-themes">SF2 Themes</a>
			</dd>
			<dt>Listening</dt><dd>WWII with Tom Hanks</dd>
			<dt>Reading</dt><dd>The Human Use of Human Beings</dd>
		</dl>
	</section>
	<section class="section">
		<SectionHeader title="Work" />
		<ul>
			<li>Day job: DevOps</li>
			<li>
				Shipping: <a href="https://github.com/douglasjarquin/pinchos">Pinchos</a> and
				<a href="https://github.com/douglasjarquin/sf2-themes">SF2 Themes</a>
			</li>
		</ul>
	</section>
	<section class="section">
		<SectionHeader title="Learning" />
		<ul>
			<li>Japanese</li>
		</ul>
	</section>
	<section class="section">
		<SectionHeader title="Saying no" />
		<ul>
			<li>Declining: everything except Golf rounds</li>
			<li>Paused: anything that isn't strictly AI or purposely not AI</li>
		</ul>
	</section>
	<section class="section">
		<p>
			Ask me about it on <a href="https://x.com/douglasjarquin">X</a>. What I use is on
			<a href="/uses/">Uses</a>.
		</p>
	</section>
</PageLayout>
