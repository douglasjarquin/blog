---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import Note from "@/components/note/Note.astro";
import Pagination from "@/components/Paginator.astro";
import SectionHeader from "@/components/theme/SectionHeader.astro";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const allNotes = (await getCollection("note")).sort(collectionDateSort);
	return paginate(allNotes, { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"note">>;
}

const { page } = Astro.props;
const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← Previous page", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "Next page →", url: page.url.next } }),
};
---

<PageLayout meta={{ description: "Read my collection of notes", title: "Notes" }}>
  <div class="page-intro">
    <h1>Notes</h1>
    <p>Small thoughts. Usually shorter than a post.</p>
  </div>

  <section class="section">
    <SectionHeader title="Recent notes" />
    <ul>
      {page.data.map((note) => <li><Note note={note} as="h2" isPreview /></li>)}
    </ul>
  </section>

  <Pagination {...paginationProps} />
</PageLayout>
