---
import SectionHeader from "@/components/theme/SectionHeader.astro";
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout meta={{ description: "A little about Doug", title: "About" }}>
	<section class="section">
		<h1>About</h1>
		<p class="lead">
			I'm Doug — an engineer at Zumba, living in Davie, Florida. I like building small, sharp tools,
			mostly for macOS and the terminal, and writing about what I learn along the way.
		</p>
	</section>
	<section class="section">
		<SectionHeader title="Now" />
		<dl>
			<dt>Watching</dt><dd>Formula 1 — forza Ferrari</dd>
			<dt>Playing</dt><dd>Golf</dd>
			<dt>Building</dt><dd>
				<a href="https://github.com/douglasjarquin/pinchos">pinchos</a>, a declarative menu bar for
				macOS
			</dd>
		</dl>
	</section>
	<section class="section">
		<SectionHeader title="Elsewhere" />
		<p>
			<a href="https://github.com/douglasjarquin">GitHub</a> · <a
				href="https://www.linkedin.com/in/douglasjarquin/">LinkedIn</a
			> · <a href="https://x.com/douglasjarquin">X</a>
		</p>
	</section>
</PageLayout>
