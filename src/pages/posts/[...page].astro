---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import SectionHeader from "@/components/theme/SectionHeader.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = (await getAllPosts()).sort(collectionDateSort);
	return paginate(allPosts, {
		pageSize: 10,
		props: { uniqueTags: getUniqueTags(allPosts).slice(0, 7) },
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
	uniqueTags: string[];
}

const { page, uniqueTags } = Astro.props;
const groupedByYear = groupPostsByYear(page.data);
const yearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← Previous page", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "Next page →", url: page.url.next } }),
};
---

<PageLayout meta={{ description: "Read my collection of posts and the things that interest me", title: "Posts" }}>
  <div class="page-intro">
    <h1>Posts</h1>
    <p>Things I've written down so I can find them again.</p>
  </div>

  {yearKeys.map((year) => (
    <section class="section">
      <SectionHeader title={year} />
      <div>
        {groupedByYear[year]?.map((post) => <PostPreview post={post} withDesc />)}
      </div>
    </section>
  ))}

  {uniqueTags.length > 0 && (
    <section class="section">
      <SectionHeader title="Tags" />
      <ul class="tag-list">
        {uniqueTags.map((tag) => <li><a href={"/tags/" + tag + "/"}>#{tag}</a></li>)}
      </ul>
    </section>
  )}

  <Pagination {...paginationProps} />
</PageLayout>
