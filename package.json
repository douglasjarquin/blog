{
	"name": "blog",
	"type": "module",
	"version": "6.11.0",
	"scripts": {
		"postinstall": "npm rebuild sharp --force",
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"postbuild": "pagefind --site dist && pnpm run check:catalog",
		"check:catalog": "node scripts/validate-ai-catalog.mjs dist/.well-known/ai-catalog.json",
		"preview": "astro preview",
		"check": "astro check && biome check",
		"lint": "biome check --write",
		"format": "prettier -w . --cache"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.8",
		"@astrojs/mdx": "8.1.6",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.5",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.4.12",
		"astro-expressive-code": "^0.44.3",
		"astro-icon": "^1.2.0",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"cssnano": "^9.1.0",
		"hastscript": "^9.0.0",
		"mdast-util-directive": "^3.2.0",
		"mdast-util-to-markdown": "^2.2.3",
		"mdast-util-to-string": "^4.0.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"satori": "0.63.2",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.5",
