	},
	"engines": {
		"node": ">=22.23.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.6.7",
		"@iconify-json/mdi": "^1.2.2",
		"@pagefind/default-ui": "^1.5.2",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"autoprefixer": "^10.6.2",
		"pagefind": "^1.5.2",
		"prettier": "^3.10.0",
		"prettier-plugin-astro": "1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"reading-time": "^1.5.0",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "@tailwindcss/oxide", "esbuild", "sharp"],
		"overrides": {
			"sharp": "^0.35.5",
			"ajv@<8.18.0": "^8.18.0",
			"picomatch@<2.3.2": "^2.3.2",
			"fast-uri@<3.1.9": "^3.1.9",
			"fflate@>=0.7.0 <0.7.5": "^0.7.5",
			"@astrojs/rss>zod": "^4.6.7",
